{
  "outputDirectory": "web",
  "functions": {
    "api/v1/assess.js": {
      "memory": 1024,
      "maxDuration": 30,
      "includeFiles": "{web/model/**,web/core.mjs,node_modules/onnxruntime-web/dist/ort-wasm-simd-threaded.*}"
    }
  },
  "headers": [
    {
      "source": "/model/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=86400" }]
    }
  ]
}
